{
  "openapi": "3.1.1",
  "info": {
    "title": "Paragrafen.Api | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/register": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Paragrafen.Api"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnonymousTypeOfstring"
                }
              }
            }
          }
        }
      }
    },
    "/ask": {
      "post": {
        "tags": [
          "AskEndpoints"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AskResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/results": {
      "get": {
        "tags": [
          "Results"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnonymousTypeOfstring": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AnswerStatus": {
        "enum": [
          "answered",
          "not_found",
          "out_of_scope"
        ]
      },
      "AskRequest": {
        "required": [
          "question"
        ],
        "type": "object",
        "properties": {
          "question": {
            "type": "string"
          },
          "conversation_id": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "AskResponse": {
        "required": [
          "request_id",
          "conversation_id",
          "status",
          "answer",
          "sources",
          "asked_at"
        ],
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/AnswerStatus"
          },
          "answer": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          },
          "asked_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AuthResponse": {
        "required": [
          "token",
          "expires_at",
          "user"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        }
      },
      "CallStats": {
        "required": [
          "calls",
          "answered",
          "not_found",
          "out_of_scope",
          "errors",
          "error_rate",
          "cost_nok_total",
          "cost_nok_median",
          "cost_nok_p95",
          "latency_ms_p50",
          "latency_ms_p95",
          "llm_latency_ms_p50",
          "input_tokens",
          "cached_tokens",
          "output_tokens",
          "reasoning_tokens"
        ],
        "type": "object",
        "properties": {
          "calls": {
            "type": "integer",
            "format": "int32"
          },
          "answered": {
            "type": "integer",
            "format": "int32"
          },
          "not_found": {
            "type": "integer",
            "format": "int32"
          },
          "out_of_scope": {
            "type": "integer",
            "format": "int32"
          },
          "errors": {
            "type": "integer",
            "format": "int32"
          },
          "error_rate": {
            "type": "number",
            "format": "double"
          },
          "cost_nok_total": {
            "type": "number",
            "format": "double"
          },
          "cost_nok_median": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "cost_nok_p95": {
            "type": [
              "null",
              "number"
            ],
            "format": "double"
          },
          "latency_ms_p50": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "latency_ms_p95": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "llm_latency_ms_p50": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "input_tokens": {
            "type": "integer",
            "format": "int64"
          },
          "cached_tokens": {
            "type": "integer",
            "format": "int64"
          },
          "output_tokens": {
            "type": "integer",
            "format": "int64"
          },
          "reasoning_tokens": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "DayStats": {
        "required": [
          "date",
          "stats"
        ],
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "stats": {
            "$ref": "#/components/schemas/CallStats"
          }
        }
      },
      "ErrorDetail": {
        "required": [
          "code",
          "message"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "required": [
          "request_id",
          "error"
        ],
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "RecentCall": {
        "required": [
          "request_id",
          "created_at",
          "status",
          "failure_reason",
          "model",
          "attempts",
          "input_tokens",
          "output_tokens",
          "cost_nok",
          "latency_ms"
        ],
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "failure_reason": {
            "type": [
              "null",
              "string"
            ]
          },
          "model": {
            "type": [
              "null",
              "string"
            ]
          },
          "attempts": {
            "type": "integer",
            "format": "int32"
          },
          "input_tokens": {
            "type": "integer",
            "format": "int32"
          },
          "output_tokens": {
            "type": "integer",
            "format": "int32"
          },
          "cost_nok": {
            "type": "number",
            "format": "double"
          },
          "latency_ms": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "user_name",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "ResultsResponse": {
        "required": [
          "generated_at",
          "total",
          "days",
          "recent_calls"
        ],
        "type": "object",
        "properties": {
          "generated_at": {
            "type": "string",
            "format": "date-time"
          },
          "total": {
            "$ref": "#/components/schemas/CallStats"
          },
          "days": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DayStats"
            }
          },
          "recent_calls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecentCall"
            }
          }
        }
      },
      "Source": {
        "required": [
          "chunk_id",
          "law",
          "description",
          "section",
          "url"
        ],
        "type": "object",
        "properties": {
          "chunk_id": {
            "type": "string"
          },
          "law": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      },
      "UserResponse": {
        "required": [
          "id",
          "email",
          "user_name",
          "roles"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "security": [
    {
      "Bearer": [ ]
    }
  ],
  "tags": [
    {
      "name": "Authentication"
    },
    {
      "name": "Paragrafen.Api"
    },
    {
      "name": "AskEndpoints"
    },
    {
      "name": "Results"
    }
  ]
}